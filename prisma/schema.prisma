// prisma/schema.prisma

model Product {
  id   String @id @default(cuid())
  name String
  slug String @unique

  description String?
  price       Float

  // SEO Fields
  metaTitle       String?
  metaDescription String?

  // RELATION: A product can have many images
  images ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NEW MODEL: For storing multiple image URLs per product
model ProductImage {
  id  String @id @default(cuid())
  url String

  // RELATION: Each image belongs to one product
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
